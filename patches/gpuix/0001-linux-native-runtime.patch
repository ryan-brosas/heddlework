new file mode 100644
index 0000000..f5d8993
--- /dev/null
+++ b/packages/native/src/system_appearance.rs
@@ -0,0 +1,113 @@
+//! Window-independent Settings delivery. The TSFN targets a guarded trampoline,
+//! not the application listener: disposal also fences events already queued.
+use napi::bindgen_prelude::{Function, FunctionRef};
+use napi::threadsafe_function::ThreadsafeFunctionCallMode;
+use napi::{CleanupEnvHook, Env, Result};
+use napi_derive::napi;
+use std::cell::{Cell, RefCell};
+use std::rc::{Rc, Weak};
+
+#[napi(object)]
+pub struct SystemAppearanceEvent {
+    pub status: String,
+    pub preference: Option<String>,
+    pub reason: Option<String>,
+}
+
+struct State {
+    active: Cell<bool>,
+    env_alive: Cell<bool>,
+    listener: RefCell<Option<FunctionRef<SystemAppearanceEvent, ()>>>,
+    #[cfg(target_os = "linux")]
+    task: RefCell<Option<gpui_platform::SystemAppearanceSubscription>>,
+}
+impl State {
+    fn dispose(&self) {
+        self.active.set(false);
+        #[cfg(target_os = "linux")]
+        self.task.borrow_mut().take();
+        self.listener.borrow_mut().take();
+    }
+}
+
+#[napi]
+pub struct SystemAppearanceSubscription {
+    state: Rc<State>,
+    env: Env,
+    hook: Option<CleanupEnvHook<Weak<State>>>,
+}
+
+#[napi]
+impl SystemAppearanceSubscription {
+    #[napi]
+    pub fn dispose(&mut self) {
+        self.state.dispose();
+        if let Some(hook) = self.hook.take() {
+            if self.state.env_alive.get() {
+                let _ = self.env.remove_env_cleanup_hook(hook);
+            }
+        }
+    }
+}
+impl Drop for SystemAppearanceSubscription {
+    fn drop(&mut self) { self.dispose(); }
+}
+
+#[napi]
+pub fn subscribe_system_appearance(
+    env: Env,
+    listener: Function<SystemAppearanceEvent, ()>,
+) -> Result<SystemAppearanceSubscription> {
+    let state = Rc::new(State {
+        active: Cell::new(true),
+        env_alive: Cell::new(true),
+        listener: RefCell::new(Some(listener.create_ref()?)),
+        #[cfg(target_os = "linux")]
+        task: RefCell::new(None),
+    });
+    let weak = Rc::downgrade(&state);
+    let trampoline = env.create_function_from_closure::<SystemAppearanceEvent, (), _>(
+        "deliverSystemAppearance", move |ctx| {
+            let Some(state) = weak.upgrade() else { return Ok(()); };
+            if !state.active.get() { return Ok(()); }
+            // Release the RefCell borrow before calling JS: a listener may dispose itself.
+            let listener = state.listener.borrow().as_ref()
+                .map(|listener| listener.borrow_back(&ctx.env)).transpose()?;
+            if let Some(listener) = listener { listener.call(ctx.get::<SystemAppearanceEvent>(0)?)?; }
+            Ok(())
+        },
+    )?;
+    let callback = trampoline.build_threadsafe_function::<SystemAppearanceEvent>()
+        .callee_handled::<false>().weak::<true>().build()?;
+    let hook = env.add_env_cleanup_hook(Rc::downgrade(&state), |weak| {
+        if let Some(state) = weak.upgrade() {
+            state.env_alive.set(false);
+            state.dispose();
+        }
+    })?;
+    #[cfg(target_os = "linux")]
+    {
+        let task = gpui_platform::SystemAppearanceSubscription::new(move |result| {
+            let event = match result {
+                Ok(value) => SystemAppearanceEvent {
+                    status: "available".into(),
+                    preference: Some(match value {
+                        gpui_platform::AppearancePreference::None => "none",
+                        gpui_platform::AppearancePreference::Dark => "dark",
+                        gpui_platform::AppearancePreference::Light => "light",
+                    }.into()), reason: None,
+                },
+                Err(reason) => SystemAppearanceEvent {
+                    status: "unavailable".into(), preference: None, reason: Some(reason),
+                },
+            };
+            callback.call(event, ThreadsafeFunctionCallMode::NonBlocking);
+        });
+        *state.task.borrow_mut() = Some(task);
+    }
+    #[cfg(not(target_os = "linux"))]
+    callback.call(SystemAppearanceEvent {
+        status: "unavailable".into(), preference: None, reason: Some("unsupported-platform".into()),
+    }, ThreadsafeFunctionCallMode::NonBlocking);
+    Ok(SystemAppearanceSubscription { state, env, hook: Some(hook) })
+}
