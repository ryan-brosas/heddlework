diff --git a/packages/native/src/portal_file_chooser.rs b/packages/native/src/portal_file_chooser.rs
new file mode 100644
index 0000000..4344f7b
--- /dev/null
+++ b/packages/native/src/portal_file_chooser.rs
@@ -0,0 +1,230 @@
+//! Window-parented XDG directory chooser delivery. The TSFN targets a guarded
+//! trampoline, not the application listener: disposal also fences events
+//! already queued, and the `closed` promise settles even when the listener is
+//! disabled. Delivery safeguards follow the appearance module.
+use crate::renderer::{recv_ui_response, GpuixRenderer, UiCommand};
+use napi::bindgen_prelude::{FromNapiValue, Function, FunctionRef, Object};
+use napi::threadsafe_function::ThreadsafeFunctionCallMode;
+use napi::{CleanupEnvHook, Env, JsValue, Result};
+use napi_derive::napi;
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+#[napi(object)]
+pub struct DirectoryDialogOptions {
+  pub title: Option<String>,
+}
+
+#[napi(object)]
+pub struct DirectoryDialogResult {
+  pub status: String,
+  pub path: Option<String>,
+  pub reason: Option<String>,
+  /// Renders as `safeToFallback` in JavaScript.
+  pub safe_to_fallback: Option<bool>,
+}
+
+/// Resolves the handle's `closed` promise from any thread.
+type CleanupResolver = Box<dyn FnOnce(Env) -> Result<String> + Send>;
+type CleanupDeferred = napi::JsDeferred<String, CleanupResolver>;
+
+struct State {
+  active: Cell<bool>,
+  listener: RefCell<Option<FunctionRef<DirectoryDialogResult, ()>>>,
+  #[cfg(target_os = "linux")]
+  request: RefCell<Option<gpui_platform::DirectoryRequest>>,
+}
+impl State {
+  fn dispose(&self) {
+    self.active.set(false);
+    #[cfg(target_os = "linux")]
+    // Dropping the transport sends the portal close signal from this thread,
+    // so environment teardown never waits for a JavaScript turn.
+    self.request.borrow_mut().take();
+    self.listener.borrow_mut().take();
+  }
+}
+
+/// Cleanup settlement shared between the JS thread and the transport thread.
+struct Shared {
+  env_alive: AtomicBool,
+  deferreds: Mutex<Vec<CleanupDeferred>>,
+  settled: Mutex<Option<String>>,
+}
+impl Shared {
+  fn settle(&self, outcome: &str) {
+    let mut settled = self.settled.lock().unwrap();
+    if settled.is_some() {
+      return;
+    }
+    *settled = Some(outcome.to_string());
+    let deferreds = std::mem::take(&mut *self.deferreds.lock().unwrap());
+    drop(settled);
+    for deferred in deferreds {
+      let value = outcome.to_string();
+      deferred.resolve(Box::new(move |_| Ok(value.clone())));
+    }
+  }
+}
+
+#[napi]
+pub struct DirectoryDialogRequest {
+  state: Rc<State>,
+  shared: Arc<Shared>,
+  env: Env,
+  hook: Option<CleanupEnvHook<Arc<Shared>>>,
+}
+
+#[napi]
+impl DirectoryDialogRequest {
+  /// Settles independently of result delivery: `closed` when native cleanup
+  /// is confirmed, `uncertain` when a dialog may still be open. Resolves once.
+  #[napi(getter, ts_return_type = "Promise<'closed' | 'uncertain'>")]
+  pub fn closed(&self, env: Env) -> Result<Object<'static>> {
+    let (deferred, promise) = env.create_deferred::<String, CleanupResolver>()?;
+    if let Some(outcome) = self.shared.settled.lock().unwrap().clone() {
+      deferred.resolve(Box::new(move |_| Ok(outcome)));
+    } else {
+      self.shared.deferreds.lock().unwrap().push(deferred);
+    }
+    // The promise outlives the local borrow; Object's lifetime is a marker.
+    let raw = JsValue::raw(&promise);
+    unsafe { <Object<'static> as FromNapiValue>::from_napi_value(env.raw(), raw) }
+  }
+
+  #[napi]
+  pub fn dispose(&mut self) {
+    self.state.dispose();
+    if let Some(hook) = self.hook.take() {
+      if self.shared.env_alive.load(Ordering::Acquire) {
+        let _ = self.env.remove_env_cleanup_hook(hook);
+      }
+    }
+  }
+}
+impl Drop for DirectoryDialogRequest {
+  fn drop(&mut self) {
+    self.dispose();
+  }
+}
+
+#[napi]
+pub fn open_directory_dialog(
+  env: Env,
+  renderer: &GpuixRenderer,
+  options: Option<DirectoryDialogOptions>,
+  listener: Function<DirectoryDialogResult, ()>,
+) -> Result<DirectoryDialogRequest> {
+  let state = Rc::new(State {
+    active: Cell::new(true),
+    listener: RefCell::new(Some(listener.create_ref()?)),
+    #[cfg(target_os = "linux")]
+    request: RefCell::new(None),
+  });
+  let shared = Arc::new(Shared {
+    env_alive: AtomicBool::new(true),
+    deferreds: Mutex::new(Vec::new()),
+    settled: Mutex::new(None),
+  });
+  let weak = Rc::downgrade(&state);
+  let trampoline = env.create_function_from_closure::<DirectoryDialogResult, (), _>(
+    "deliverDirectoryDialog", move |ctx| {
+      let Some(state) = weak.upgrade() else { return Ok(()); };
+      if !state.active.get() { return Ok(()); }
+      // Release the RefCell borrow before calling JS: a listener may dispose itself.
+      let listener = state.listener.borrow().as_ref()
+        .map(|listener| listener.borrow_back(&ctx.env)).transpose()?;
+      if let Some(listener) = listener { listener.call(ctx.get::<DirectoryDialogResult>(0)?)?; }
+      Ok(())
+    },
+  )?;
+  let callback = Arc::new(trampoline.build_threadsafe_function::<DirectoryDialogResult>()
+    .callee_handled::<false>().weak::<true>().build()?);
+  let hook = env.add_env_cleanup_hook(shared.clone(), |shared: Arc<Shared>| {
+    shared.env_alive.store(false, Ordering::Release);
+    shared.deferreds.lock().unwrap().clear();
+  })?;
+
+  let title = options.and_then(|options| options.title);
+
+  #[cfg(target_os = "linux")]
+  {
+    // Capture the invoking window before scheduling asynchronous work so the
+    // dialog parents to this renderer's window, not whichever one is focused later.
+    let (response_sender, response_receiver) = std::sync::mpsc::sync_channel(1);
+    renderer.send_ui_command(UiCommand::GetParentIdentifier { response: response_sender })?;
+    let parent_window = recv_ui_response(response_receiver, "the GPUI parent window query").ok().flatten();
+    match parent_window {
+      Some(parent_window) => {
+        let shared_for_transport = shared.clone();
+        let callback_for_transport = callback.clone();
+        let request = gpui_platform::DirectoryRequest::new(
+          Some(parent_window),
+          title,
+          move |event| match event {
+            gpui_platform::DirectoryEvent::Response(response) => {
+              let result = match response {
+                gpui_platform::DirectoryResponse::Selected(path) => DirectoryDialogResult {
+                  status: "selected".into(),
+                  path: Some(path),
+                  reason: None,
+                  safe_to_fallback: None,
+                },
+                gpui_platform::DirectoryResponse::Cancelled => DirectoryDialogResult {
+                  status: "cancelled".into(),
+                  path: None,
+                  reason: None,
+                  safe_to_fallback: None,
+                },
+                gpui_platform::DirectoryResponse::Unavailable { reason, safe_to_fallback } => {
+                  DirectoryDialogResult {
+                    status: "unavailable".into(),
+                    path: None,
+                    reason: Some(reason),
+                    safe_to_fallback: Some(safe_to_fallback),
+                  }
+                }
+              };
+              callback_for_transport.call(result, ThreadsafeFunctionCallMode::NonBlocking);
+            }
+            gpui_platform::DirectoryEvent::Cleanup(outcome) => {
+              let outcome = match outcome {
+                gpui_platform::DirectoryCleanupOutcome::Closed => "closed",
+                gpui_platform::DirectoryCleanupOutcome::Uncertain => "uncertain",
+              };
+              shared_for_transport.settle(outcome);
+            }
+          },
+        );
+        *state.request.borrow_mut() = Some(request);
+      }
+      None => {
+        // No live invoking window: fail before opening the dialog. Retry and
+        // fallback remain safe because nothing was opened.
+        let _ = callback.call(DirectoryDialogResult {
+          status: "unavailable".into(),
+          path: None,
+          reason: Some("The invoking window could not be identified".into()),
+          safe_to_fallback: Some(true),
+        }, ThreadsafeFunctionCallMode::NonBlocking);
+        shared.settle("closed");
+      }
+    }
+  }
+
+  #[cfg(not(target_os = "linux"))]
+  {
+    let _ = title;
+    let _ = callback.call(DirectoryDialogResult {
+      status: "unavailable".into(),
+      path: None,
+      reason: Some("unsupported-platform".into()),
+      safe_to_fallback: Some(true),
+    }, ThreadsafeFunctionCallMode::NonBlocking);
+    shared.settle("closed");
+  }
+
+  Ok(DirectoryDialogRequest { state, shared, env, hook: Some(hook) })
+}
