+/// `org.freedesktop.portal.FileChooser.OpenFile` takes `(parent_window, title,
+/// options)`. Sending the title inside `options` left the portal reading the
+/// options dictionary as the title and the call without its third argument.
+fn open_file_args(
+  parent: String,
+  title: Option<String>,
+  token: String,
+) -> (String, String, HashMap<&'static str, Value<'static>>) {
+  let mut options = HashMap::new();
+  options.insert("handle_token", Value::from(token));
+  options.insert("modal", Value::from(true));
+  options.insert("multiple", Value::from(false));
+  options.insert("directory", Value::from(true));
+  (parent, title.unwrap_or_else(|| "Open folder".into()), options)
+}
