+//! Owned, raw XDG appearance subscription, independent of window appearance policy.
+use ashpd::desktop::settings::Settings;
+use futures::{FutureExt, StreamExt};
+use std::time::Duration;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AppearancePreference { None, Dark, Light }
+pub fn appearance_preference(value: u32) -> AppearancePreference {
+    match value { 1 => AppearancePreference::Dark, 2 => AppearancePreference::Light, _ => AppearancePreference::None }
+}
+
+/// Dropping the handle cancels initialization or the pending stream read.
+pub struct SystemAppearanceSubscription { _task: smol::Task<()> }
+impl SystemAppearanceSubscription {
+    pub fn new(mut emit: impl FnMut(Result<AppearancePreference, String>) + Send + 'static) -> Self {
+        let task = smol::spawn(async move {
+            let run = async {
+                let settings = Settings::new().await?;
+                let owners = settings.receive_owner_changed().await?;
+                let changes = settings.receive_setting_changed_with_args::<u32>("org.freedesktop.appearance", "color-scheme").await?;
+                let initial = settings.read::<u32>("org.freedesktop.appearance", "color-scheme").await?;
+                anyhow::Ok((settings, changes, owners, initial))
+            };
+            let setup = futures::future::select(Box::pin(run), Box::pin(smol::Timer::after(Duration::from_secs(6)))).await;
+            let (_settings, mut changes, mut owners, mut value) = match setup {
+                futures::future::Either::Left((Ok(result), _)) => result,
+                futures::future::Either::Left((Err(error), _)) => { emit(Err(error.to_string())); return; }
+                futures::future::Either::Right(_) => { emit(Err("Settings initialization timed out".into())); return; }
+            };
+            match owners.next().now_or_never() {
+                Some(None) => { emit(Err("Settings stream closed".into())); return; }
+                Some(Some(_)) => { emit(Err("Settings portal owner changed".into())); return; }
+                None => {}
+            }
+            // Signals already buffered during Read supersede its potentially older snapshot.
+            loop {
+                match changes.next().now_or_never() {
+                    Some(Some(Ok(next))) => value = next,
+                    Some(Some(Err(error))) => { emit(Err(error.to_string())); return; }
+                    Some(None) => { emit(Err("Settings stream closed".into())); return; }
+                    None => break,
+                }
+            }
+            let mut previous = appearance_preference(value);
+            emit(Ok(previous));
+            loop {
+                let next = match futures::future::select(Box::pin(changes.next()), Box::pin(owners.next())).await {
+                    futures::future::Either::Left((Some(next), _)) => next,
+                    futures::future::Either::Left((None, _)) => break,
+                    futures::future::Either::Right((owner, _)) => {
+                        emit(Err(if owner.is_none() { "Settings stream closed" } else { "Settings portal owner changed" }.into()));
+                        return;
+                    }
+                };
+                match next {
+                    Ok(value) => {
+                        let preference = appearance_preference(value);
+                        if preference != previous { previous = preference; emit(Ok(preference)); }
+                    }
+                    Err(error) => { emit(Err(error.to_string())); return; }
+                }
+            }
+            emit(Err("Settings stream closed".into()));
+        });
+        Self { _task: task }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn maps_raw_preferences_without_inventing_light() {
+        assert_eq!(appearance_preference(0), AppearancePreference::None);
+        assert_eq!(appearance_preference(1), AppearancePreference::Dark);
+        assert_eq!(appearance_preference(2), AppearancePreference::Light);
+        assert_eq!(appearance_preference(u32::MAX), AppearancePreference::None);
+    }
+}
